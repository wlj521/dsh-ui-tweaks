{
  "name": "dsh-ui-tweaks",
  "version": "0.16.0",
  "description": "DSH web plugin: live-tune the conversation UI — code font size (px input), a timeline switch (DSH's native turn rail, or the classic v0.11 web rail: hover to preview, click to jump; native by default), a poster theme skin (neon poster, light/dark), a GitBar (branch chip in the session header with branch management, plus terminal and code-diff tabs in the native right sidebar with per-file diff and commit & push, and a real PTY terminal over a WebSocket to a persistent node-pty shell), task alerts that call you back via tab-title flash / system notification / chime when any session finishes its turn or starts waiting for your approval, plan review or answer, an /init slash command that submits an AGENTS.md bootstrap prompt (Chinese or English) into the current session, and a precise cache-hit readout that keeps two decimal places on the stats line's cache-hit figure under the input box — from the Settings panel. Requires DSH v0.1.5-alpha.1+ (the conversation timeline and dialog width are now native to DSH).",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "deepseek",
    "deepseek-ai",
    "cordis",
    "plugin",
    "ui-tweaks",
    "chat-ui"
  ],
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wlj521/dsh-ui-tweaks.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "assets",
    "vendor",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.client.json && node scripts/build-client.mjs",
    "prepublishOnly": "pnpm build",
    "prepare": "tsc -p tsconfig.json && tsc -p tsconfig.client.json && node scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.public.json"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-store",
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-session"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-api-session-controller": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-api-workspace-controller": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-client-locale": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-client-store": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-client-ui-commands": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-client-ui-session": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-client-ui-workspace": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-session": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-session-projection": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-settings": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-storage-domain": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-token-meter": "^0.1.5-alpha.1",
    "@deepseek-ai/dsh-workspace": "^0.1.5-alpha.1",
    "@deepseek-ai/schemastery": "^3.18.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "cordis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-api-session-controller": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-api-workspace-controller": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-client-locale": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-client-store": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-client-ui-commands": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-client-ui-session": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-client-ui-workspace": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-host-webserver": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-session": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-session-persistence": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-session-projection": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-settings": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-storage-domain": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-token-meter": "0.1.5-alpha.1",
    "@deepseek-ai/dsh-workspace": "0.1.5-alpha.1",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.1",
    "@types/ws": "^8.5.10",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.7.0",
    "zod": "^4.5.4"
  },
  "dependencies": {
    "node-pty": "^1.1.0",
    "ws": "^8.18.0",
    "yaml": "2.9.0"
  }
}
